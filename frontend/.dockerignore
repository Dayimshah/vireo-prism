# Keep the build context small and the image reproducible.
#
# node_modules is the important entry: copying the host's tree would ship whatever
# platform-specific binaries this machine installed, and `npm ci` in the builder stage
# would be reinstalling on top of them.
node_modules
dist
dist-ssr

# Build caches
.vite
node_modules/.tmp
*.tsbuildinfo
coverage

# Local environment. Vite inlines VITE_* at build time, so a stray .env.local in the
# context would silently override the build args compose passes in.
.env
.env.*
!.env.example

# Editor and OS noise
.vscode
.idea
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-error.log*
*.log
