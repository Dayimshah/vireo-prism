# ===========================================================================
# Prism — Vireo Product Analytics Platform
# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. `.env` is git-ignored and never baked into images.
#
#   cp .env.example .env          (macOS / Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# Naming convention: application settings are prefixed PRISM_ and nested
# sections use a double underscore, e.g. PRISM_DB__HOST -> settings.db.host.
# Variables without the prefix are consumed by the Docker images themselves.
# ===========================================================================

# ---------------------------------------------------------------------------
# Postgres container bootstrap (read by the official postgres image only)
# ---------------------------------------------------------------------------
POSTGRES_USER=prism
POSTGRES_PASSWORD=change-me-in-real-deployments
POSTGRES_DB=vireo

# Host port mapping. Deliberately 5433 so a Postgres you already run locally
# on 5432 does not collide with the container.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
API_HOST_PORT=8000
WEB_HOST_PORT=5173

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
PRISM_ENV=development
PRISM_DEBUG=true
PRISM_LOG_LEVEL=INFO
# Force machine-readable logs in development (defaults to true when ENV != development)
PRISM_LOG_JSON=false

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Inside Docker the host is the service name `postgres`.
# Running the API on your host machine instead? Use localhost + POSTGRES_HOST_PORT.
PRISM_DB__HOST=postgres
PRISM_DB__PORT=5432
PRISM_DB__USER=prism
PRISM_DB__PASSWORD=change-me-in-real-deployments
PRISM_DB__NAME=vireo
PRISM_DB__POOL_SIZE=10
PRISM_DB__MAX_OVERFLOW=20
PRISM_DB__POOL_TIMEOUT_SECONDS=30
PRISM_DB__STATEMENT_TIMEOUT_MS=30000
PRISM_DB__ECHO_SQL=false

# ---------------------------------------------------------------------------
# Redis (optional — the API falls back to an in-process LRU cache if absent)
# ---------------------------------------------------------------------------
PRISM_REDIS__ENABLED=true
PRISM_REDIS__HOST=redis
PRISM_REDIS__PORT=6379
PRISM_REDIS__DB=0
PRISM_REDIS__PASSWORD=
PRISM_REDIS__SOCKET_TIMEOUT_SECONDS=2

# ---------------------------------------------------------------------------
# Caching (seconds). Analytics answers are historical, so TTLs can be generous.
# ---------------------------------------------------------------------------
PRISM_CACHE__ENABLED=true
PRISM_CACHE__DEFAULT_TTL_SECONDS=300
PRISM_CACHE__KPI_TTL_SECONDS=180
PRISM_CACHE__HEAVY_TTL_SECONDS=900
PRISM_CACHE__LOCAL_MAX_ENTRIES=512
PRISM_CACHE__KEY_NAMESPACE=prism:v1

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
PRISM_API__ROOT_PATH=
PRISM_API__CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PRISM_API__MAX_PAGE_SIZE=200
PRISM_API__DEFAULT_PAGE_SIZE=50
PRISM_API__MAX_DATE_RANGE_DAYS=730
# Guards the only mutating endpoint, POST /api/v1/admin/refresh
PRISM_API__ADMIN_KEY=local-dev-admin-key

# ---------------------------------------------------------------------------
# Synthetic data generation
# ---------------------------------------------------------------------------
# small = 3k users (~15s) | medium = 25k users (~3min) | large = 100k users (~15min)
PRISM_SEED__PROFILE=medium
# Fixed seed => byte-identical dataset on every machine. Do not change casually;
# the screenshots and documented findings in docs/ are anchored to this value.
PRISM_SEED__RANDOM_SEED=20240817
# Simulation window end. Leave blank to use today's date at generation time.
PRISM_SEED__WINDOW_END=
PRISM_SEED__WINDOW_MONTHS=18
PRISM_SEED__COPY_BATCH_ROWS=50000

# ---------------------------------------------------------------------------
# Frontend build-time config (Vite only exposes VITE_* to the browser bundle)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Prism
VITE_ORG_NAME=Vireo
